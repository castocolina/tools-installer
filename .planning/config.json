{
  "model_profile": "adaptive",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "phase",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": true,
    "human_verify_mode": "end-of-phase",
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "deep",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "ui_review": true,
    "use_worktrees": true,
    "plan_review_convergence": true,
    "cross_ai_execution": true,
    "cross_ai_command": "pi -p --model router-env/my-coding --no-session",
    "cross_ai_timeout": 3600
  },
  "review": {
    "reviewer_instances": {
      "opencode-plan-review": {
        "cli": "opencode",
        "model": "router-env/my-plan-review"
      },
      "opencode-gpt-sol": {
        "cli": "opencode",
        "model": "openai/gpt-6.1-sol#xhigh"
      },
      "opencode-glm": {
        "cli": "opencode",
        "model": "zai-coding-plan/glm-5.3#high"
      }
    },
    "default_reviewers": [
      "opencode-plan-review"
    ],
    "timeouts": {
      "opencode": 2400
    },
    "effort": {
      "opencode": "inherit"
    }
  },
  "ship": {
    "pr_body_sections": []
  },
  "hooks": {
    "context_warnings": false
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {
    "gsd-plan-checker": [
      "global:jev-fast-decision"
    ],
    "gsd-verifier": [
      "global:jev-fast-decision"
    ],
    "gsd-code-reviewer": [
      "global:jev-fast-decision",
      "global:ponytail:ponytail-review"
    ],
    "gsd-security-auditor": [
      "global:jev-fast-decision"
    ],
    "gsd-ui-checker": [
      "global:jev-fast-decision"
    ],
    "gsd-ui-auditor": [
      "global:jev-fast-decision"
    ],
    "gsd-eval-auditor": [
      "global:jev-fast-decision"
    ],
    "gsd-integration-checker": [
      "global:jev-fast-decision"
    ],
    "gsd-doc-verifier": [
      "global:jev-fast-decision"
    ],
    "gsd-nyquist-auditor": [
      "global:jev-fast-decision"
    ],
    "gsd-dom-verifier": [
      "global:jev-fast-decision"
    ],
    "gsd-planner": [
      "global:ponytail:ponytail"
    ],
    "gsd-executor": [
      "global:ponytail:ponytail"
    ],
    "gsd-code-fixer": [
      "global:ponytail:ponytail"
    ],
    "gsd-roadmapper": [
      "global:ponytail:ponytail"
    ],
    "gsd-advisor-researcher": [
      "global:jev-fast-decision"
    ],
    "gsd-assumptions-analyzer": [
      "global:jev-fast-decision"
    ]
  },
  "claude_md_path": "./CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "mode": "yolo",
  "granularity": "fine",
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true,
    "auto_update": true
  },
  "models": {
    "planning": "opus",
    "discuss": "sonnet",
    "research": "sonnet",
    "verification": "opus",
    "execution": "haiku"
  },
  "model_overrides": {
    "gsd-planner": "fable",
    "gsd-code-reviewer": "fable"
  },
  "effort": {
    "default": "medium",
    "agent_overrides": {
      "gsd-planner": "xhigh",
      "gsd-plan-checker": "xhigh",
      "gsd-code-reviewer": "xhigh",
      "gsd-ui-auditor": "xhigh"
    }
  }
}
