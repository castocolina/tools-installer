{
  "model_profile": "adaptive",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "phase",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": true,
    "human_verify_mode": "end-of-phase",
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "deep",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "ui_review": true,
    "use_worktrees": true,
    "plan_review_convergence": true,
    "cross_ai_execution": true,
    "cross_ai_command": "/usr/local/bin/opencode run --model router-env/my-coding",
    "cross_ai_timeout": 3600
  },
  "review": {
    "reviewer_instances": {
      "opencode-plan-review": {
        "cli": "opencode",
        "model": "router-env/my-plan-review"
      },
      "opencode-sol": {
        "cli": "opencode",
        "model": "openai/gpt-5.6-sol"
      },
      "codex-sol-high": {
        "cli": "codex",
        "model": "gpt-5.6-sol"
      }
    },
    "default_reviewers": [
      "opencode-plan-review"
    ]
  },
  "ship": {
    "pr_body_sections": []
  },
  "hooks": {
    "context_warnings": false
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "mode": "yolo",
  "granularity": "fine",
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true,
    "auto_update": true
  },
  "models": {
    "planning": "opus",
    "discuss": "sonnet",
    "research": "sonnet",
    "verification": "opus",
    "execution": "haiku"
  },
  "model_overrides": {
    "gsd-planner": "opus",
    "gsd-code-reviewer": "opus"
  },
  "effort": {
    "default": "medium",
    "agent_overrides": {
      "gsd-planner": "high",
      "gsd-plan-checker": "high",
      "gsd-code-reviewer": "high",
      "gsd-ui-auditor": "high"
    }
  }
}
