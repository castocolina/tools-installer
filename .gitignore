# GSD tooling runtime state (dispatch sentinels, etc.) - not part of the audit trail
.gsd/

# Raw cross-AI review diagnostics (per-attempt logs/stderr feeding replanning) -
# ephemeral working material; once findings are folded into a plan, a code fix,
# or a -REVIEW.md/-REVIEWS.md summary, the raw dump has no ongoing value
.review-diagnostics/

# GSD milestone-run lock file (session id/pid/timestamp) - runtime-only, never audit trail
.planning/milestone.lock

.codex/
.claude/
.cursor/
.opencode/

# Empty file some test/validate run regenerates at the repo root - reproducible, not audit trail
/log
